{
  "name": "marketplace-auth-service",
  "version": "1.0.0",
  "private": true,
  "license": "MarketplaceTM",
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "codegen": "orval --config ./scripts/orval.config.ts && prettier --write \"src/validation/**/*.ts\"",
    "db:push": "drizzle-kit push --config ./src/repositories/drizzle.config.ts",
    "seed": "node ./scripts/seed-users.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \".github/workflows/**/*.yml\"",
    "test": "tsx --test --import ./tests/setup.ts tests/unit/*.test.ts tests/oauth/*.test.ts tests/mfa/*.test.ts tests/security/*.test.ts",
    "test:integration": "tsx --test --import ./tests/setup.ts tests/integration/*.test.ts",
    "test:e2e": "tsx --test --import ./tests/setup.ts tests/e2e/*.test.ts",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@types/express-rate-limit": "^6.0.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "ip-address": "10.3.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qs": "6.16.0",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "orval": "^8.9.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}

